# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must keep LF to run on Linux
*.sh text eol=lf
packaging/arch/PKGBUILD.in text eol=lf

# Windows-specific files keep CRLF
*.sln text eol=crlf
*.ps1 text eol=crlf

# Binary reference documents
*.pdf binary
*.ico binary
*.png binary
*.jpg binary
*.ttf binary
