# PKGBUILD for Arch Linux and derivatives. Built from the release's Linux tarball.
#   makepkg -si
pkgname=tempo-dg645-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Control software for Stanford Research Systems DG645 digital delay generators"
arch=('x86_64')
url="@REPOSITORY@"
license=('LicenseRef-unknown')
depends=('libx11' 'libice' 'libsm' 'fontconfig')
provides=('tempo-dg645')
conflicts=('tempo-dg645')
# The program is a self-contained .NET single-file bundle; stripping it would corrupt it.
options=('!strip' '!debug')
source=("Tempo-${pkgver}-linux-x64.tar.gz::${url}/releases/download/v${pkgver}/Tempo-${pkgver}-linux-x64.tar.gz")
sha256sums=('@SHA256@')

package() {
    cd "$srcdir/tempo-dg645"
    install -Dm755 tempo-dg645 "$pkgdir/opt/tempo-dg645/tempo-dg645"
    install -dm755 "$pkgdir/usr/bin"
    ln -s /opt/tempo-dg645/tempo-dg645 "$pkgdir/usr/bin/tempo-dg645"
    install -Dm644 tempo-dg645.desktop "$pkgdir/usr/share/applications/tempo-dg645.desktop"
    install -Dm644 tempo-dg645.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/tempo-dg645.png"
}
