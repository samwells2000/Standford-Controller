<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StanfordController.Presentation.ViewModels;assembly=StanfordController.Presentation"
             xmlns:core="clr-namespace:StanfordController.Core.Protocol;assembly=StanfordController.Core"
             xmlns:help="clr-namespace:StanfordController.Presentation.Help;assembly=StanfordController.Presentation"
             xmlns:inf="clr-namespace:StanfordController.App.Infrastructure"
             x:Class="StanfordController.App.Views.TerminalView"
             x:DataType="vm:InstrumentSessionViewModel"
             inf:HelpContext.Topic="{x:Static help:HelpTopics.Terminal}">
    <Grid Margin="20,16,20,14" ColumnDefinitions="3*,24,2*" DataContext="{Binding Terminal}" x:DataType="vm:TerminalViewModel">

        <!-- Console: dark in both themes -->
        <Border Background="{DynamicResource TerminalBrush}" CornerRadius="3" BorderBrush="{DynamicResource TerminalBorderBrush}" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource TerminalBorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                            <Button Classes="terminal" Command="{Binding SendCommand}" Content="Send" />
                            <Button Classes="terminal" Command="{Binding ClearCommand}" Content="Clear" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&gt;" FontFamily="{StaticResource MonoFont}" FontSize="14"
                                   Foreground="{DynamicResource TerminalPromptBrush}" VerticalAlignment="Center" Margin="2,0,8,0" />
                        <TextBox x:Name="Input" Text="{Binding Input}" Classes="param terminal" AutomationProperties.Name="Command to send"
                                 PlaceholderText="e.g. DLAY?2 or TRAT 1000">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                                <KeyBinding Gesture="Up" Command="{Binding HistoryUpCommand}" />
                                <KeyBinding Gesture="Down" Command="{Binding HistoryDownCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </DockPanel>
                </Border>
                <CheckBox DockPanel.Dock="Bottom" IsChecked="{Binding CheckErrors}" Margin="12,0,0,6" Classes="terminal"
                          Content="Check for errors (LERR?) after each command" />
                <ListBox Classes="terminal" ItemsSource="{Binding Lines}" inf:ListBehavior.AutoScroll="True" Margin="4,8,4,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TerminalLine">
                            <Grid ColumnDefinitions="18,*">
                                <TextBlock Text="{Binding Prefix}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                           Foreground="{Binding Kind, Converter={x:Static inf:TerminalLineBrushConverter.Instance}}" />
                                <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="13" TextWrapping="Wrap"
                                                     Foreground="{Binding Kind, Converter={x:Static inf:TerminalLineBrushConverter.Instance}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Command reference -->
        <HeaderedContentControl Grid.Column="2" Theme="{StaticResource Section}" Header="Command reference" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="Double-click a command to put its example in the terminal. c = channel (0 T0, 1 T1, 2 A … 9 H); b = output (0 T0, 1 AB … 4 GH)." />
                    <TextBox Text="{Binding Filter}" PlaceholderText="Search commands" AutomationProperties.Name="Search commands" />
                </StackPanel>
                <Border Classes="framed">
                    <ListBox ItemsSource="{Binding FilteredCommands}" SelectedItem="{Binding SelectedCommand}"
                             inf:ListBehavior.DoubleTapCommand="{Binding InsertCommand}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:CommandInfo">
                                <StackPanel Margin="0,1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Classes="caption" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Syntax}" Classes="mono" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Classes="secondary" Margin="0,1,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </HeaderedContentControl>
    </Grid>
</UserControl>
