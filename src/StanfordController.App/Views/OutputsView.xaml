<UserControl x:Class="StanfordController.App.Views.OutputsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StanfordController.Presentation.ViewModels;assembly=StanfordController.Presentation">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,12,8">
            <TextBlock Style="{StaticResource CardSubtitle}" FontSize="13" Margin="0,0,0,14"
                       Text="Set the amplitude, offset and polarity of each front-panel output. TTL and NIM presets configure common logic levels in one click." />

            <ItemsControl ItemsSource="{Binding Outputs}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OutputViewModel}">
                        <Border Style="{StaticResource Card}" Width="410" Margin="0,0,12,12">
                            <StackPanel>
                                <!-- Header -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SeriesBadge}" Tag="{Binding Output}" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource SeriesDot}" Tag="{Binding Output}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="6,0,0,0" Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LevelSummary}" Style="{StaticResource MonoText}" FontSize="12" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding TimingText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <HeaderedContentControl Style="{StaticResource FormRowNarrow}" Header="Amplitude">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Content="{Binding Amplitude}" ContentTemplate="{StaticResource TextField}" Focusable="False" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Top">
                                            <Button Style="{StaticResource IconButton}" Content="{StaticResource IconUp}" Command="{Binding AmplitudeUpCommand}" ToolTip="Step up (SPLA b,1)" AutomationProperties.Name="Increase amplitude by one step" />
                                            <Button Style="{StaticResource IconButton}" Content="{StaticResource IconDown}" Command="{Binding AmplitudeDownCommand}" ToolTip="Step down (SPLA b,0)" Margin="4,0,0,0" AutomationProperties.Name="Decrease amplitude by one step" />
                                        </StackPanel>
                                    </Grid>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource FormRowNarrow}" Header="Offset">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Content="{Binding Offset}" ContentTemplate="{StaticResource TextField}" Focusable="False" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Top">
                                            <Button Style="{StaticResource IconButton}" Content="{StaticResource IconUp}" Command="{Binding OffsetUpCommand}" ToolTip="Step up (SPLO b,1)" AutomationProperties.Name="Increase offset by one step" />
                                            <Button Style="{StaticResource IconButton}" Content="{StaticResource IconDown}" Command="{Binding OffsetDownCommand}" ToolTip="Step down (SPLO b,0)" Margin="4,0,0,0" AutomationProperties.Name="Decrease offset by one step" />
                                        </StackPanel>
                                    </Grid>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource FormRowNarrow}" Header="Polarity">
                                    <ContentControl Content="{Binding Polarity}" ContentTemplate="{StaticResource ChoiceField}" Focusable="False" />
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource FormRowNarrow}" Header="Amplitude step">
                                    <ContentControl Content="{Binding AmplitudeStep}" ContentTemplate="{StaticResource TextField}" Focusable="False" />
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource FormRowNarrow}" Header="Offset step">
                                    <ContentControl Content="{Binding OffsetStep}" ContentTemplate="{StaticResource TextField}" Focusable="False" />
                                </HeaderedContentControl>

                                <StackPanel Orientation="Horizontal" Margin="120,4,0,0">
                                    <Button Command="{Binding TtlCommand}" Content="TTL preset" ToolTip="4 V pulses from 0 V, positive polarity" />
                                    <Button Command="{Binding NimCommand}" Content="NIM preset" Margin="8,0,0,0" ToolTip="−0.8 V pulses from 0 V (offset −0.8 V, amplitude 0.8 V, negative polarity)" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Margin="120,6,0,0"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
