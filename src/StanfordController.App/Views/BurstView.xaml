<UserControl x:Class="StanfordController.App.Views.BurstView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,8" DataContext="{Binding Burst}" MaxWidth="720" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Burst mode" />
                    <TextBlock Style="{StaticResource CardSubtitle}"
                               Text="In burst mode every trigger produces a train of delay cycles: a burst delay after the trigger, then a set number of cycles separated by the burst period." />

                    <HeaderedContentControl Style="{StaticResource FormRow}" Header="Burst mode">
                        <ContentControl Content="{Binding Enabled}" ContentTemplate="{StaticResource ToggleField}" Focusable="False" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource FormRow}" Header="Cycles per burst">
                        <ContentControl Content="{Binding Count}" ContentTemplate="{StaticResource TextField}" Focusable="False" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource FormRow}" Header="Burst period">
                        <ContentControl Content="{Binding Period}" ContentTemplate="{StaticResource TextField}" Focusable="False" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource FormRow}" Header="Burst delay">
                        <ContentControl Content="{Binding Delay}" ContentTemplate="{StaticResource TextField}" Focusable="False" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource FormRow}" Header="T0 output">
                        <ContentControl Content="{Binding T0Mode}" ContentTemplate="{StaticResource ChoiceField}" Focusable="False" />
                    </HeaderedContentControl>

                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10" Margin="0,8,0,0"
                            Visibility="{Binding Summary, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
