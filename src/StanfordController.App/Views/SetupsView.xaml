<UserControl x:Class="StanfordController.App.Views.SetupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,8" MaxWidth="760" HorizontalAlignment="Left">

            <!-- ============================== Files ============================== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Settings files" />
                    <TextBlock Style="{StaticResource CardSubtitle}"
                               Text="Save every delay, output level, trigger and burst setting to a file on this PC. Files can be archived with your experiment, shared with colleagues, or loaded into any DG645." />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconSave}" FontSize="12" Foreground="White" />
                                <TextBlock Text="Save settings to file…" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportSettingsCommand}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconOpen}" FontSize="12" />
                                <TextBlock Text="Load settings from file…" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================== Instrument memory ============================== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Instrument memory" />
                    <TextBlock Style="{StaticResource CardSubtitle}"
                               Text="The DG645 can store nine complete setups in its own non-volatile memory (*SAV / *RCL). These stay with the instrument and can also be recalled from its front panel." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Save current settings to" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SaveSlots}" SelectedItem="{Binding SaveSlot}" ItemStringFormat="Location {0}" />
                        <Button Grid.Column="2" Command="{Binding SaveToSlotCommand}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconSave}" FontSize="12" />
                                <TextBlock Text="Save" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Recall settings from" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding RecallSlots}" SelectedItem="{Binding RecallSlot}" DisplayMemberPath="Label" />
                        <Button Grid.Row="2" Grid.Column="2" Command="{Binding RecallSlotCommand}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconOpen}" FontSize="12" />
                                <TextBlock Text="Recall" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================== Reset ============================== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Reset" />
                    <TextBlock Style="{StaticResource CardSubtitle}"
                               Text="Return the instrument to its default settings (*RST). All current delays, output levels, trigger and burst settings are replaced." />
                    <Button Style="{StaticResource DangerButton}" Command="{Binding ResetCommand}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconReset}" FontSize="12" />
                            <TextBlock Text="Reset to defaults…" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
