<UserControl x:Class="StanfordController.App.Views.InstrumentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StanfordController.Presentation.ViewModels;assembly=StanfordController.Presentation"
             xmlns:views="clr-namespace:StanfordController.App.Views">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:InstrumentSessionViewModel}">
            <views:SessionView />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- ============================== Header ============================== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" Padding="28,20,28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource PageTitle}" MaxWidth="560" />
                        <Border Style="{StaticResource StateBadge}" Tag="{Binding State}" Margin="14,2,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StateDot}" Tag="{Binding State}" Width="8" Height="8" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding Address, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                        <Run Text="  ·  " Foreground="{DynamicResource TextMutedBrush}" />
                        <Run Text="{Binding Location, Mode=OneWay, TargetNullValue='No location set'}" />
                    </TextBlock>

                    <!-- Identity when connected, otherwise when last seen -->
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" FontSize="12"
                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="{Binding Session.Model, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="  ·  Serial" />
                        <Run Text="{Binding Session.SerialNumber, Mode=OneWay}" />
                        <Run Text="  ·  Firmware" />
                        <Run Text="{Binding Session.Firmware, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" FontSize="12" Text="{Binding LastSeen}"
                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Command="{Binding DataContext.EditInstrumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" Style="{StaticResource GhostButton}" ToolTip="Edit name, address and options">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconEdit}" FontSize="12" />
                            <TextBlock Text="Edit" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DisconnectCommand}" Margin="8,0,0,0"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconDisconnect}" FontSize="11" />
                            <TextBlock Text="Disconnect" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconConnect}" FontSize="12" Foreground="White" />
                            <TextBlock Text="Connect" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}" />

        <!-- ============================== Body ============================== -->
        <Grid>
            <ContentControl Content="{Binding Session}" Focusable="False" />

            <!-- Not connected -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Session, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                <Border Style="{StaticResource Card}" Width="620" Margin="0,48,0,24" Padding="32,28" VerticalAlignment="Top">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Margin="0,0,0,18"
                                     Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Style="{StaticResource CardTitle}" FontSize="18" Text="{Binding StateText}" />

                        <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,4"
                                Visibility="{Binding LastError, Converter={StaticResource NullToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconWarning}" Foreground="{DynamicResource DangerTextBrush}"
                                           VerticalAlignment="Top" Margin="0,2,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding LastError}" TextWrapping="Wrap" Foreground="{DynamicResource DangerStrongTextBrush}" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource CardSubtitle}" Margin="0,10,0,18" FontSize="13"
                                   Text="Connect to read the instrument's current settings. All delays, levels, trigger, burst, status and interface settings become available once connected." />

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Address" Margin="0,0,0,8" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding Address}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Location" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Location, TargetNullValue='—'}" Margin="0,0,0,8" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Notes" VerticalAlignment="Top" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Notes, TargetNullValue='—'}" TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Padding="20,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconConnect}" FontSize="12" Foreground="White" />
                                    <TextBlock Text="Connect" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"
                                       Text="Tip: double-click an instrument in the list to connect." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
