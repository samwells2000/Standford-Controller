<UserControl x:Class="StanfordController.App.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:StanfordController.Core.Protocol;assembly=StanfordController.Core"
             xmlns:inf="clr-namespace:StanfordController.App.Infrastructure">

    <Grid Margin="24,20,24,16" DataContext="{Binding Terminal}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="360" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" MinWidth="280" MaxWidth="460" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Console ============================== -->
        <Border Background="{DynamicResource TerminalBrush}" CornerRadius="10" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource TerminalBorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SendCommand}" Content="Send" />
                            <Button Command="{Binding ClearCommand}" Content="Clear" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&gt;" FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="#93C5FD"
                                   VerticalAlignment="Center" Margin="2,0,8,0" />
                        <TextBox x:Name="Input" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="13.5"
                                 Background="{DynamicResource TerminalInputBrush}" Foreground="{DynamicResource TerminalTextBrush}" BorderBrush="{DynamicResource TerminalBorderBrush}" CaretBrush="White">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                                <KeyBinding Key="Up" Command="{Binding HistoryUpCommand}" />
                                <KeyBinding Key="Down" Command="{Binding HistoryDownCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </Border>
                <CheckBox DockPanel.Dock="Bottom" IsChecked="{Binding CheckErrors}" Margin="14,0,0,8" Foreground="{DynamicResource TerminalMutedBrush}" FontSize="12"
                          Content="Check for errors (LERR?) after each command" />
                <ListBox ItemsSource="{Binding Lines}" Background="Transparent" BorderThickness="0" Margin="8,10,8,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" inf:AutoScrollBehavior.IsEnabled="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Margin="6,1" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Prefix}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                           Foreground="{Binding Kind, Converter={StaticResource TerminalLineBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{Binding Kind, Converter={StaticResource TerminalLineBrush}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================== Command reference ============================== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="16,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Command reference" />
                    <TextBlock Style="{StaticResource CardSubtitle}" Margin="0,0,0,8"
                               Text="Double-click a command to copy its example into the terminal. c = channel (0 T0, 1 T1, 2 A … 9 H), b = output (0 T0, 1 AB … 4 GH)." />
                    <Grid Margin="0,0,0,8">
                        <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="30,0,8,0" />
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconSearch}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Search commands" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="31,0,0,0"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Filter, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                    </Grid>
                </StackPanel>
                <ListBox ItemsSource="{Binding FilteredCommands}" SelectedItem="{Binding SelectedCommand}" Style="{StaticResource PlainList}"
                         ItemContainerStyle="{StaticResource PlainListItem}"
                         inf:DoubleClickBehavior.Command="{Binding InsertCommand}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:CommandInfo}">
                            <StackPanel Margin="0,2">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Syntax}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="12.5" />
                                </DockPanel>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
