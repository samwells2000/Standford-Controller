<UserControl x:Class="StanfordController.App.Views.DelaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StanfordController.Presentation.ViewModels;assembly=StanfordController.Presentation"
             xmlns:controls="clr-namespace:StanfordController.App.Controls"
             xmlns:inf="clr-namespace:StanfordController.App.Infrastructure">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,8">

            <!-- ============================== Channel delays ============================== -->
            <Border Style="{StaticResource Card}">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Channel delays" />
                    <TextBlock Style="{StaticResource CardSubtitle}"
                               Text="Each channel fires at its reference channel's time plus a delay. Channels A–B set the AB output pulse, C–D set CD, E–F set EF and G–H set GH. Type values such as 1.5 us, 250 ns, 2 ms or 1e-6 and press Enter." />

                    <!-- Column headers -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="Name" Width="64" />
                            <ColumnDefinition SharedSizeGroup="Ref" Width="96" />
                            <ColumnDefinition SharedSizeGroup="Plus" Width="28" />
                            <ColumnDefinition SharedSizeGroup="Delay" Width="200" />
                            <ColumnDefinition SharedSizeGroup="Steps" Width="80" />
                            <ColumnDefinition SharedSizeGroup="Abs" Width="190" />
                            <ColumnDefinition SharedSizeGroup="StepSize" Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColumnHeader}" Text="CHANNEL" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="REFERENCE" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="DELAY" />
                        <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="STEP" Margin="6,0,0,0" />
                        <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeader}" Text="TIME FROM T0" Margin="14,0,0,0" />
                        <TextBlock Grid.Column="6" Style="{StaticResource ColumnHeader}" Text="STEP SIZE" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Channels}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChannelDelayViewModel}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition SharedSizeGroup="Name" />
                                        <ColumnDefinition SharedSizeGroup="Ref" />
                                        <ColumnDefinition SharedSizeGroup="Plus" />
                                        <ColumnDefinition SharedSizeGroup="Delay" />
                                        <ColumnDefinition SharedSizeGroup="Steps" />
                                        <ColumnDefinition SharedSizeGroup="Abs" />
                                        <ColumnDefinition SharedSizeGroup="StepSize" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Style="{StaticResource Badge}" Background="{Binding Channel, Converter={StaticResource OutputBrush}}"
                                            MinWidth="36" ToolTip="{Binding Role}">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Border>

                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ReferenceOptions}" SelectedItem="{Binding Reference}"
                                              DisplayMemberPath="Label" ToolTip="Channel this delay is measured from (DLAY c,d,t)" />

                                    <TextBlock Grid.Column="2" Text="+" FontSize="15" Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <TextBox Grid.Column="3" Style="{StaticResource ParamTextBox}"
                                             Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}"
                                             inf:FieldBehavior.CommitCommand="{Binding CommitCommand}"
                                             inf:FieldBehavior.RevertCommand="{Binding RevertCommand}"
                                             ToolTip="{Binding Role}" />

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconUp}" Command="{Binding StepUpCommand}"
                                                ToolTip="Increase by the step size (SPDL c,1)" />
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconDown}" Command="{Binding StepDownCommand}"
                                                ToolTip="Decrease by the step size (SPDL c,0)" Margin="4,0,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="5" Text="{Binding AbsoluteText}" Style="{StaticResource MonoText}"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="14,0,8,0" />

                                    <ContentControl Grid.Column="6" Content="{Binding StepSize}" ContentTemplate="{StaticResource TextField}" Focusable="False" />

                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="7" Style="{StaticResource ErrorText}" Text="{Binding Error}"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============================== Timing diagram ============================== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Timing diagram" />
                    <TextBlock Style="{StaticResource CardSubtitle}"
                               Text="Output pulses relative to T0, drawn from the delays above. Negative-polarity outputs are drawn inverted." />
                    <controls:TimingDiagram Pulses="{Binding Timing}" Height="270" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
