<UserControl x:Class="StanfordController.App.Views.DelaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StanfordController.Presentation.ViewModels;assembly=StanfordController.Presentation"
             xmlns:controls="clr-namespace:StanfordController.App.Controls"
             xmlns:inf="clr-namespace:StanfordController.App.Infrastructure">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,8">

            <!-- ============================== Channel delays ============================== -->
            <Border Style="{StaticResource Card}">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Channel delays" />
                    <TextBlock Style="{StaticResource CardSubtitle}"
                               Text="Each channel fires at its reference channel's time plus a delay. Channels A–B set the AB output pulse, C–D set CD, E–F set EF and G–H set GH. Type values such as 1.5 us, 250 ns, 2 ms or 1e-6 and press Enter." />

                    <!-- Column headers -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="Name" Width="56" />
                            <ColumnDefinition SharedSizeGroup="Ref" Width="84" />
                            <ColumnDefinition SharedSizeGroup="Plus" Width="22" />
                            <ColumnDefinition SharedSizeGroup="Delay" Width="150" />
                            <ColumnDefinition SharedSizeGroup="Steps" Width="78" />
                            <ColumnDefinition SharedSizeGroup="Abs" Width="136" />
                            <ColumnDefinition SharedSizeGroup="StepSize" Width="104" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColumnHeader}" Text="CHANNEL" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="REFERENCE" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="DELAY" />
                        <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="STEP" Margin="6,0,0,0" />
                        <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeader}" Text="FROM T0" Margin="12,0,0,0" />
                        <TextBlock Grid.Column="6" Style="{StaticResource ColumnHeader}" Text="STEP SIZE" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Channels}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChannelDelayViewModel}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition SharedSizeGroup="Name" />
                                        <ColumnDefinition SharedSizeGroup="Ref" />
                                        <ColumnDefinition SharedSizeGroup="Plus" />
                                        <ColumnDefinition SharedSizeGroup="Delay" />
                                        <ColumnDefinition SharedSizeGroup="Steps" />
                                        <ColumnDefinition SharedSizeGroup="Abs" />
                                        <ColumnDefinition SharedSizeGroup="StepSize" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Style="{StaticResource SeriesBadge}" Tag="{Binding Output}" ToolTip="{Binding Role}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource SeriesDot}" Tag="{Binding Output}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="6,0,0,0" Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ReferenceOptions}" SelectedItem="{Binding Reference}"
                                              DisplayMemberPath="Label" AutomationProperties.Name="Reference channel"
                                              ToolTip="Channel this delay is measured from (DLAY c,d,t). Changing it keeps the delay value, so the time from T0 changes." />

                                    <TextBlock Grid.Column="2" Text="+" FontSize="15" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <TextBox Grid.Column="3" Style="{StaticResource ParamTextBox}"
                                             Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}"
                                             inf:FieldBehavior.CommitCommand="{Binding CommitCommand}"
                                             inf:FieldBehavior.RevertCommand="{Binding RevertCommand}"
                                             ToolTip="{Binding Role}" />

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconUp}" Command="{Binding StepUpCommand}"
                                                ToolTip="Increase by the step size (SPDL c,1)" AutomationProperties.Name="Increase delay by one step" />
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconDown}" Command="{Binding StepDownCommand}"
                                                ToolTip="Decrease by the step size (SPDL c,0)" Margin="4,0,0,0" AutomationProperties.Name="Decrease delay by one step" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="5" Text="{Binding AbsoluteText}" Style="{StaticResource MonoText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,8,0" />

                                    <ContentControl Grid.Column="6" Content="{Binding StepSize}" ContentTemplate="{StaticResource TextField}" Focusable="False" />

                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="7" Style="{StaticResource ErrorText}" Text="{Binding Error}"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============================== Timing diagram ============================== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Timing diagram" />
                    <TextBlock Style="{StaticResource CardSubtitle}"
                               Text="Output pulses relative to T0, drawn from the delays above. Negative-polarity outputs are drawn inverted. Hover for exact edge times." />
                    <controls:TimingDiagram Pulses="{Binding Timing}" Height="290"
                                            TextBrush="{DynamicResource TextBrush}" MutedBrush="{DynamicResource TextMutedBrush}"
                                            GridBrush="{DynamicResource ChartGridBrush}" AxisBrush="{DynamicResource ChartAxisBrush}"
                                            WarningBrush="{DynamicResource WarningTextBrush}" PanelBrush="{DynamicResource SurfaceBrush}"
                                            T0Brush="{DynamicResource SeriesT0Brush}" ABBrush="{DynamicResource SeriesABBrush}"
                                            CDBrush="{DynamicResource SeriesCDBrush}" EFBrush="{DynamicResource SeriesEFBrush}"
                                            GHBrush="{DynamicResource SeriesGHBrush}"
                                            AutomationProperties.Name="Timing diagram of the output pulses" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
