<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StanfordController.App</RootNamespace>
    <AssemblyName>Tempo</AssemblyName>
    <AssemblyTitle>Tempo</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No dependency on the system ICU library, so the Linux build runs on any distribution. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    dotnet publish -r win-x64 | linux-x64 produces one self-contained file: the .NET runtime, Avalonia,
    the Skia renderer and the fonts are all inside. Add -p:PortableBuild=true for the portable variant.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(PortableBuild)' == 'true'">
    <AssemblyMetadata Include="PortableBuild" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StanfordController.Core\StanfordController.Core.csproj" />
    <ProjectReference Include="..\StanfordController.Presentation\StanfordController.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The two-sided quick reference card, opened from Help (rebuild with docs/quick-reference/build.mjs). -->
    <EmbeddedResource Include="..\..\docs\Tempo-Quick-Reference.pdf" LogicalName="Tempo.QuickReference.pdf" Link="Assets\Tempo-Quick-Reference.pdf" />
    <!-- The user guide's pictures (docs/images, rebuilt with docs/images/build.mjs). -->
    <EmbeddedResource Include="..\..\docs\images\*.png" LogicalName="Tempo.Guide.%(Filename)%(Extension)" Link="Help\Images\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- SkiaSharp ships native debug symbols (~100 MB); keep them out of the published program. -->
  <Target Name="DropNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
