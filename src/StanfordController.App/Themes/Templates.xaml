<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:inf="clr-namespace:StanfordController.App.Infrastructure">

    <inf:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <inf:NullToVisibilityConverter x:Key="NullToVisibility" />
    <inf:InverseBoolConverter x:Key="InverseBool" />
    <inf:NotNullConverter x:Key="NotNull" />
    <inf:TerminalLineBrushConverter x:Key="TerminalLineBrush" />

    <!-- EditableParameterViewModel<T>: text box that applies on Enter / leaving the field. -->
    <DataTemplate x:Key="TextField">
        <StackPanel>
            <TextBox Style="{StaticResource ParamTextBox}"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly, Mode=OneWay}"
                     inf:FieldBehavior.CommitCommand="{Binding CommitCommand}"
                     inf:FieldBehavior.RevertCommand="{Binding RevertCommand}" />
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- ChoiceParameterViewModel: combo box that applies on selection. -->
    <DataTemplate x:Key="ChoiceField">
        <StackPanel>
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                      ToolTip="{Binding Hint}" />
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- ToggleParameterViewModel: switch that applies when flipped. -->
    <DataTemplate x:Key="ToggleField">
        <StackPanel>
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsChecked}" ToolTip="{Binding Hint}"
                      HorizontalAlignment="Left" Margin="0,5,0,0" />
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- ToggleParameterViewModel with its own label beside the switch. -->
    <DataTemplate x:Key="LabelledToggle">
        <StackPanel Margin="0,0,0,10">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsChecked}" ToolTip="{Binding Hint}"
                      Content="{Binding Label}" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- One bit of a status register, with its enable checkbox. -->
    <DataTemplate x:Key="StatusBitRow">
        <Grid Margin="0,0,0,7" ToolTip="{Binding Description}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Style="{StaticResource Led}" Tag="{Binding IsSet}" />
            <TextBlock Grid.Column="1" Text="{Binding Bit}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource MonoText}" FontSize="12" />
            <TextBlock Grid.Column="3" Text="{Binding Description}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,8,0" />
            <CheckBox Grid.Column="4" IsChecked="{Binding IsEnabled}" Content="Enable"
                      IsEnabled="{Binding IsUsed}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
