<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Colour tokens for the light and dark themes. Neutral Windows greys with the Windows accent blue;
        text tokens meet WCAG AA (4.5:1) on every surface they are used on, including the selection colour;
        control borders and status marks meet 3:1. Series colours are the validated categorical palette
        (blue, orange, aqua, yellow) and always sit next to a text label.
        The second half of each dictionary points the Fluent control theme at the same tokens.
    -->

    <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>
    <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
    <x:Double x:Key="ToolTipContentThemeFontSize">12</x:Double>

    <ResourceDictionary.ThemeDictionaries>

        <!-- ============================== Light ============================== -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ChromeBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="ChromeHoverBrush" Color="#E8E8E8" />
            <SolidColorBrush x:Key="ChromePressedBrush" Color="#DEDEDE" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F9F9F9" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="PopupBrush" Color="#F9F9F9" />
            <SolidColorBrush x:Key="PopupBorderBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="BorderBrush" Color="#DCDCDC" />
            <SolidColorBrush x:Key="GridLineBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="ControlFillBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#8A8A8A" />
            <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#6E6E6E" />
            <SolidColorBrush x:Key="FocusBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#CCE8FF" />
            <SolidColorBrush x:Key="SelectionHoverBrush" Color="#E5F3FF" />
            <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4D4D4D" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#616161" />
            <SolidColorBrush x:Key="AccentBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A6FC2" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#004C93" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="SuccessTextBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DFF6DD" />
            <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="WarningTextBrush" Color="#8A5100" />
            <SolidColorBrush x:Key="WarningStrongTextBrush" Color="#5E3A00" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF4CE" />
            <SolidColorBrush x:Key="WarningBorderBrush" Color="#E3C46A" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="DangerStrongTextBrush" Color="#9A1F14" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE7E9" />
            <SolidColorBrush x:Key="DangerBorderBrush" Color="#EBA7AE" />
            <SolidColorBrush x:Key="DirtyFieldBrush" Color="#FFF8E1" />
            <SolidColorBrush x:Key="ErrorFieldBrush" Color="#FDE7E9" />
            <SolidColorBrush x:Key="SeriesT0Brush" Color="#6B6B6B" />
            <SolidColorBrush x:Key="SeriesABBrush" Color="#2A78D6" />
            <SolidColorBrush x:Key="SeriesCDBrush" Color="#EB6834" />
            <SolidColorBrush x:Key="SeriesEFBrush" Color="#1BAF7A" />
            <SolidColorBrush x:Key="SeriesGHBrush" Color="#EDA100" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="ChartAxisBrush" Color="#BDBDBD" />
            <SolidColorBrush x:Key="LogSentBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="LogReceivedBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="LogErrorBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="LogInfoBrush" Color="#616161" />
            <SolidColorBrush x:Key="LedOffBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="LedOffStrokeBrush" Color="#ABABAB" />
            <SolidColorBrush x:Key="TerminalBrush" Color="#0C0C0C" />
            <SolidColorBrush x:Key="TerminalInputBrush" Color="#171717" />
            <SolidColorBrush x:Key="TerminalBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="TerminalTextBrush" Color="#CCCCCC" />
            <SolidColorBrush x:Key="TerminalMutedBrush" Color="#8C8C8C" />
            <SolidColorBrush x:Key="TerminalPromptBrush" Color="#61D6D6" />
            <SolidColorBrush x:Key="TerminalErrorBrush" Color="#F48771" />

            <!-- Fluent control theme -->
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlBorderBrush" />
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlBorderHoverBrush" />
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AccentBrush" />
            <StaticResource x:Key="TextControlBackground" ResourceKey="ControlFillBrush" />
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ControlFillBrush" />
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="ControlFillBrush" />
            <StaticResource x:Key="ButtonBackground" ResourceKey="ControlFillBrush" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfacePressedBrush" />
            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlBorderBrush" />
            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlBorderHoverBrush" />
            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlBorderHoverBrush" />
            <StaticResource x:Key="ComboBoxBackground" ResourceKey="ControlFillBrush" />
            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SurfaceHoverBrush" />
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="ControlBorderBrush" />
            <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="ControlBorderHoverBrush" />
            <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="PopupBrush" />
            <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="PopupBorderBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="ControlBorderBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="ControlBorderHoverBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="ControlFillBrush" />
            <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="PopupBrush" />
            <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="PopupBorderBrush" />
            <StaticResource x:Key="ToolTipBackground" ResourceKey="PopupBrush" />
            <StaticResource x:Key="ToolTipForeground" ResourceKey="TextBrush" />
            <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="PopupBorderBrush" />
            <StaticResource x:Key="ListBoxItemBackgroundPointerOver" ResourceKey="SelectionHoverBrush" />
            <StaticResource x:Key="ListBoxItemBackgroundSelected" ResourceKey="SelectionBrush" />
            <StaticResource x:Key="ListBoxItemBackgroundSelectedPointerOver" ResourceKey="SelectionBrush" />
            <StaticResource x:Key="ListBoxItemBackgroundPressed" ResourceKey="SelectionBrush" />
            <StaticResource x:Key="ListBoxItemBackgroundSelectedPressed" ResourceKey="SelectionBrush" />
        </ResourceDictionary>

        <!-- ============================== Dark ============================== -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ChromeBrush" Color="#202020" />
            <SolidColorBrush x:Key="ChromeHoverBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="ChromePressedBrush" Color="#353535" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#272727" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#333333" />
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="#3B3B3B" />
            <SolidColorBrush x:Key="PopupBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="PopupBorderBrush" Color="#474747" />
            <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="GridLineBrush" Color="#333333" />
            <SolidColorBrush x:Key="ControlFillBrush" Color="#2F2F2F" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#858585" />
            <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#A6A6A6" />
            <SolidColorBrush x:Key="FocusBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#1D3D57" />
            <SolidColorBrush x:Key="SelectionHoverBrush" Color="#2A3138" />
            <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#ABABAB" />
            <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#5AB9E8" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#4FA3CF" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#000000" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="SuccessTextBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#393D1B" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="WarningTextBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="WarningStrongTextBrush" Color="#FFE97A" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#433519" />
            <SolidColorBrush x:Key="WarningBorderBrush" Color="#6B5A1E" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="DangerStrongTextBrush" Color="#FFC7CD" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#442726" />
            <SolidColorBrush x:Key="DangerBorderBrush" Color="#7A3A40" />
            <SolidColorBrush x:Key="DirtyFieldBrush" Color="#3A3220" />
            <SolidColorBrush x:Key="ErrorFieldBrush" Color="#3F2326" />
            <SolidColorBrush x:Key="SeriesT0Brush" Color="#A3A3A3" />
            <SolidColorBrush x:Key="SeriesABBrush" Color="#3987E5" />
            <SolidColorBrush x:Key="SeriesCDBrush" Color="#D95926" />
            <SolidColorBrush x:Key="SeriesEFBrush" Color="#199E70" />
            <SolidColorBrush x:Key="SeriesGHBrush" Color="#C98500" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="#353535" />
            <SolidColorBrush x:Key="ChartAxisBrush" Color="#555555" />
            <SolidColorBrush x:Key="LogSentBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="LogReceivedBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="LogErrorBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="LogInfoBrush" Color="#ABABAB" />
            <SolidColorBrush x:Key="LedOffBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="LedOffStrokeBrush" Color="#5A5A5A" />
            <SolidColorBrush x:Key="TerminalBrush" Color="#0C0C0C" />
            <SolidColorBrush x:Key="TerminalInputBrush" Color="#171717" />
            <SolidColorBrush x:Key="TerminalBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="TerminalTextBrush" Color="#CCCCCC" />
            <SolidColorBrush x:Key="TerminalMutedBrush" Color="#8C8C8C" />
            <SolidColorBrush x:Key="TerminalPromptBrush" Color="#61D6D6" />
            <SolidColorBrush x:Key="TerminalErrorBrush" Color="#F48771" />

            <!-- Fluent control theme -->
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlBorderBrush" />
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlBorderHoverBrush" />
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AccentBrush" />
            <StaticResource x:Key="TextControlBackground" ResourceKey="ControlFillBrush" />
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ControlFillBrush" />
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="ControlFillBrush" />
            <StaticResource x:Key="ButtonBackground" ResourceKey="ControlFillBrush" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfacePressedBrush" />
            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlBorderBrush" />
            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlBorderHoverBrush" />
            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlBorderHoverBrush" />
            <StaticResource x:Key="ComboBoxBackground" ResourceKey="ControlFillBrush" />
            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SurfaceHoverBrush" />
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="ControlBorderBrush" />
            <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="ControlBorderHoverBrush" />
            <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="PopupBrush" />
            <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="PopupBorderBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="ControlBorderBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="ControlBorderHoverBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="ControlFillBrush" />
            <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="PopupBrush" />
            <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="PopupBorderBrush" />
            <StaticResource x:Key="ToolTipBackground" ResourceKey="PopupBrush" />
            <StaticResource x:Key="ToolTipForeground" ResourceKey="TextBrush" />
            <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="PopupBorderBrush" />
            <StaticResource x:Key="ListBoxItemBackgroundPointerOver" ResourceKey="SelectionHoverBrush" />
            <StaticResource x:Key="ListBoxItemBackgroundSelected" ResourceKey="SelectionBrush" />
            <StaticResource x:Key="ListBoxItemBackgroundSelectedPointerOver" ResourceKey="SelectionBrush" />
            <StaticResource x:Key="ListBoxItemBackgroundPressed" ResourceKey="SelectionBrush" />
            <StaticResource x:Key="ListBoxItemBackgroundSelectedPressed" ResourceKey="SelectionBrush" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
