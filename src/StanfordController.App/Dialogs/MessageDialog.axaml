<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:StanfordController.Core;assembly=StanfordController.Core"
        x:Class="StanfordController.App.Dialogs.MessageDialog"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="chrome" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="YesButton" Classes="accent" IsDefault="True" MinWidth="88" Click="OnYes" />
                <Button x:Name="NoButton" MinWidth="88" Click="OnNo" />
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="88" Click="OnCancel" />
            </StackPanel>
        </Border>
        <Grid ColumnDefinitions="Auto,*" Margin="20,18,22,16">
            <Path x:Name="IconPath" Classes="glyph" VerticalAlignment="Top" Margin="0,1,12,0" />
            <StackPanel Grid.Column="1" Spacing="12">
                <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" />
                <!-- What the action would change: setting, value now, value after. -->
                <Border x:Name="ChangesPanel" Classes="framed" IsVisible="False">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="table-header">
                            <Grid ColumnDefinitions="2*,3*,3*">
                                <TextBlock Classes="header" Text="Setting" />
                                <TextBlock Grid.Column="1" Classes="header" Text="Now" />
                                <TextBlock Grid.Column="2" Classes="header" Text="After" />
                            </Grid>
                        </Border>
                        <ScrollViewer MaxHeight="300">
                            <ItemsControl x:Name="ChangesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:SettingChange">
                                        <Border Classes="table-row">
                                            <Grid ColumnDefinitions="2*,3*,3*">
                                                <TextBlock Text="{Binding Setting}" Classes="strong" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Before}" Classes="mono secondary" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding After}" Classes="mono" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <CheckBox x:Name="RememberBox" IsVisible="False" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
