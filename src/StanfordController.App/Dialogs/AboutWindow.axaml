<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StanfordController.App.Dialogs.AboutWindow"
        Title="About Strobe"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="chrome" BorderThickness="0,1,0,0" Padding="16,10">
            <Button Content="Close" IsCancel="True" IsDefault="True" MinWidth="88" HorizontalAlignment="Right" Click="OnClose" />
        </Border>
        <StackPanel Margin="20,18,20,16" Spacing="0">
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,14">
                <Image Source="/Assets/logo.png" Width="44" Height="44" RenderOptions.BitmapInterpolationMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Strobe" Classes="title" FontSize="18" />
                    <TextBlock x:Name="VersionText" Classes="secondary" />
                </StackPanel>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="Control software for Stanford Research Systems DG645 digital delay generators over Ethernet (TCP port 5025). Not affiliated with or endorsed by Stanford Research Systems." />

            <HeaderedContentControl Theme="{StaticResource Section}" Header="Files">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="DataKind" Classes="secondary" TextWrapping="Wrap" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open folder" Click="OnOpenFolder" Margin="10,0,0,0" VerticalAlignment="Top" />
                        <SelectableTextBlock x:Name="DataFolder" Classes="mono" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Theme="{StaticResource Section}" Header="Links" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                    <Button Classes="link" Content="Releases and change history" Click="OnReleases" />
                    <Button Classes="link" Content="Source code" Click="OnSource" />
                    <Button Classes="link" Content="DG645 remote command reference" Click="OnReference" />
                </StackPanel>
            </HeaderedContentControl>

            <TextBlock Classes="caption" Text="Set in IBM Plex Sans and IBM Plex Mono (SIL Open Font License 1.1)." />
        </StackPanel>
    </DockPanel>
</Window>
