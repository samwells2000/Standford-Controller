<Window x:Class="StanfordController.App.Dialogs.DiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:disc="clr-namespace:StanfordController.Core.Discovery;assembly=StanfordController.Core"
        Title="Find instruments"
        Width="720" Height="600" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource SurfaceBrush}"
        Closing="OnClosing">

    <Border Background="{DynamicResource SurfaceBrush}" Padding="28,24,28,22">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Find instruments on the network" Style="{StaticResource PageTitle}" FontSize="19" />
            <TextBlock Style="{StaticResource CardSubtitle}" Margin="0,4,0,14"
                       Text="Scans this PC's local networks for instruments answering on the DG645's TCP port, then asks each for its identity (*IDN?)." />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Networks" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Text="{Binding NetworksText}" Style="{StaticResource MonoText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="Port" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                    <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Width="70" FontFamily="{StaticResource MonoFont}" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconSearch}" FontSize="12" Foreground="White" />
                            <TextBlock Text="Scan" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelCommand}" Content="Stop" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Or check one address" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" />
                <TextBox Grid.Column="1" Text="{Binding ProbeAddress, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                         ToolTip="IP address or host name, e.g. 169.254.10.20 for a directly connected instrument" />
                <Button Grid.Column="2" Command="{Binding ProbeCommand}" Content="Check" Margin="8,0,0,0" />
            </Grid>

            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="0,0,0,8"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" IsCancel="True" MinWidth="90" />
            <Button Style="{StaticResource PrimaryButton}" Content="Add selected…" MinWidth="120" Margin="10,0,0,0" Click="OnAdd"
                    IsEnabled="{Binding Selected, Converter={StaticResource NotNull}}" />
        </StackPanel>

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Style="{StaticResource PlainList}"
                     ItemContainerStyle="{StaticResource PlainListItem}" Margin="4" MouseDoubleClick="OnResultDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type disc:DiscoveredInstrument}">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Badge}" Margin="0,0,12,0" MinWidth="64" Background="{DynamicResource SurfaceHoverBrush}">
                                <TextBlock Text="{Binding Model}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Address}" Style="{StaticResource MonoText}" />
                            <TextBlock Grid.Column="2" Text="{Binding Identity}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Identity}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
    </Border>
</Window>
