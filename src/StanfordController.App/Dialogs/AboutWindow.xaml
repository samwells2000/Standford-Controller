<Window x:Class="StanfordController.App.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About DG645 Controller"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource SurfaceBrush}">

    <Border Background="{DynamicResource SurfaceBrush}" Padding="28,24,28,22">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/logo.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DG645 Controller" Style="{StaticResource PageTitle}" FontSize="20" />
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource CardSubtitle}" FontSize="13" Margin="0,16,0,14"
                       Text="Controls Stanford Research Systems DG645 digital delay generators over Ethernet (TCP port 5025). Not affiliated with or endorsed by Stanford Research Systems." />

            <TextBlock Text="Keyboard shortcuts" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <ItemsControl x:Name="Shortcuts" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" Style="{StaticResource MonoText}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="Links" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
            <StackPanel>
                <TextBlock Margin="0,0,0,4">
                    <Hyperlink x:Name="ReleasesLink" RequestNavigate="OnNavigate" Foreground="{DynamicResource AccentTextBrush}">Latest release and change history</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,0,0,4">
                    <Hyperlink x:Name="ReadmeLink" RequestNavigate="OnNavigate" Foreground="{DynamicResource AccentTextBrush}">User guide (README)</Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink x:Name="ReferenceLink" RequestNavigate="OnNavigate" Foreground="{DynamicResource AccentTextBrush}">DG645 remote command reference</Hyperlink>
                </TextBlock>
            </StackPanel>

            <TextBlock Text="Your data" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Click="OnOpenFolder" Margin="10,0,0,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconFolder}" FontSize="12" />
                        <TextBlock Text="Open folder" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Saved instruments and preferences are kept in:" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DataFolder" Style="{StaticResource MonoText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <Button Content="Close" IsCancel="True" IsDefault="True" MinWidth="90" HorizontalAlignment="Right" Margin="0,22,0,0" />
        </StackPanel>
    </Border>
</Window>
