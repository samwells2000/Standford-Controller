<Window x:Class="StanfordController.App.Dialogs.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource SurfaceBrush}"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">

    <Border Background="{DynamicResource SurfaceBrush}" Padding="28,24,28,22">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="19" />
        <TextBlock Style="{StaticResource CardSubtitle}" Margin="0,4,0,20"
                   Text="Give the instrument a name you will recognise. The name is all you need to pick it next time." />

        <HeaderedContentControl Style="{StaticResource FormRow}" Header="Friendly name">
            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </HeaderedContentControl>

        <StackPanel Visibility="{Binding IsSimulator, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <HeaderedContentControl Style="{StaticResource FormRow}" Header="IP address or host">
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                         ToolTip="The instrument's IP address, shown in its front-panel network settings, or a host name. Use 'Find instruments on network' if you don't know it." />
            </HeaderedContentControl>
            <HeaderedContentControl Style="{StaticResource FormRow}" Header="TCP port">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Width="100" FontFamily="{StaticResource MonoFont}" />
                    <TextBlock Style="{StaticResource Caption}" Text="5025 is the DG645 bare-socket port." VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>

        <HeaderedContentControl Style="{StaticResource FormRow}" Header="Reply timeout (ms)">
            <TextBox Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" FontFamily="{StaticResource MonoFont}" />
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource FormRow}" Header="Location">
            <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional, e.g. 'Lab 2.14, laser table'" />
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource FormRow}" Header="Notes">
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineTextBox}" />
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource FormRow}" Header="On disconnect">
            <CheckBox IsChecked="{Binding ReturnToLocalOnDisconnect}" Content="Return the front panel to local control" Margin="0,7,0,0" />
        </HeaderedContentControl>

        <!-- Connection test -->
        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                Padding="14,12" Margin="0,6,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding TestConnectionCommand}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconConnect}" FontSize="12" />
                        <TextBlock Text="Test connection" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" Text="{Binding TestResult, TargetNullValue='Check the instrument answers before saving.'}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestSucceeded}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Validation -->
        <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0"
                Visibility="{Binding HasVisibleProblems, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ProblemsText}" Foreground="{DynamicResource DangerStrongTextBrush}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
            <Button Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="10,0,0,0" Click="OnSave" />
        </StackPanel>
    </StackPanel>
    </Border>
</Window>
