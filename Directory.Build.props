<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Tempo</Product>
    <Company>Tempo contributors</Company>
    <Copyright>Copyright © Tempo contributors</Copyright>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <!-- Symbols live inside each assembly so the published app is a single file. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
