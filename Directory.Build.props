<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Stanford DG645 Controller</Product>
    <Company>Stanford DG645 Controller contributors</Company>
    <Copyright>Copyright © Stanford DG645 Controller contributors</Copyright>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <!-- Lets the Windows desktop app be compiled from Linux/macOS too (CI publishes on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
